      "places": [],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "qty": 1 }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "cards": [{ "id": "sol", "qty": 2, "binders": [{ "id": "b1", "qty": 2, "foil": 1 }] }] },
      "do": { "flow": "remove", "card": "sol" },
