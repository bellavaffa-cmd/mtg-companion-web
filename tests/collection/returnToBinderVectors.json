        "collections": { "b1": [{ "id": "sol", "qty": 1, "places": [{ "placeId": "box", "qty": 1 }] }], "unsorted": [{ "id": "sol", "qty": 1 }] },
        "deck": { "ownership": "VIRTUAL", "cards": [{ "id": "sol", "qty": 2, "binders": [] }], "cameFrom": [] },
