        "binders": {},
        "noBinder": { "own": 0, "deck": [["d1", "sol", 1]] }
      }
    },
    {
      "name": "a proxy swapped for a binder's copy: the binder lists it in the deck, its spot noted",
      "places": ["box"],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "name": "Sol Ring", "qty": 1, "places": [{ "placeId": "box", "qty": 1 }] }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "ownership": "PROXY", "cards": [{ "id": "sol", "name": "Sol Ring", "qty": 1 }] },
      "do": { "flow": "swapIn", "card": "sol" },
      "expect": {
        "collections": { "b1": [], "unsorted": [] },
        "deck": { "cards": [{ "id": "sol", "qty": 1, "proxies": 0, "binders": [{ "id": "b1", "qty": 1 }] }], "cameFrom": [{ "name": "Sol Ring", "placeId": "box", "qty": 1 }] },
        "binders": { "b1": { "own": 0, "deck": [["d1", "sol", 1]] } },
        "noBinder": { "own": 0, "deck": [] }
      }
    },
    {
