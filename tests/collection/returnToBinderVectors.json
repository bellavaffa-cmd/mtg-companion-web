        "deck": { "cards": [{ "id": "sol", "qty": 1, "binders": [{ "id": "b1", "qty": 1 }] }], "cameFrom": [] },
        "binders": { "b1": { "own": 0, "deck": [["d1", "sol", 1]] }, "b2": { "own": 1, "deck": [] } },
        "noBinder": { "own": 0, "deck": [] }
      }
    },
    {
