        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": {
        "id": "d1",
        "cards": [
          { "id": "sol", "name": "Sol Ring", "qty": 1, "binders": [{ "id": "b1", "qty": 1 }] },
          { "id": "bolt", "qty": 2 },
          { "id": "path", "qty": 1, "binders": [{ "id": "gone", "qty": 1 }] }
        ],
        "cameFrom": [{ "name": "Sol Ring", "placeId": "box", "qty": 1 }]
      },
      "do": { "flow": "deleteDeck" },
      "expect": {
        "collections": { "b1": [{ "id": "sol", "qty": 1, "places": [{ "placeId": "box", "qty": 1 }] }], "unsorted": [{ "id": "bolt", "qty": 2 }, { "id": "path", "qty": 1 }] },
        "deck": null,
        "binders": { "b1": { "own": 1, "deck": [] } },
        "noBinder": { "own": 3, "deck": [] }
      }
    },
    {
      "name": "a physical deck made virtual: its copies go back to their binders, its refs emptied",
      "places": [],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "cards": [{ "id": "sol", "qty": 1, "binders": [{ "id": "b1", "qty": 1 }] }, { "id": "bolt", "qty": 1 }] },
      "do": { "flow": "ownership", "to": "VIRTUAL" },
      "expect": {
        "collections": { "b1": [{ "id": "sol", "qty": 1 }], "unsorted": [{ "id": "bolt", "qty": 1 }] },
        "deck": { "ownership": "VIRTUAL", "cards": [{ "id": "sol", "qty": 1, "binders": [] }, { "id": "bolt", "qty": 1 }] },
        "binders": { "b1": { "own": 1, "deck": [] } },
        "noBinder": { "own": 1, "deck": [] }
      }
    },
    {
