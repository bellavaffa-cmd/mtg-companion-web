        "deck": { "ownership": "PHYSICAL", "cards": [{ "id": "sol", "qty": 1, "binders": [{ "id": "b1", "qty": 1 }] }], "cameFrom": [{ "name": "Sol Ring", "placeId": "box", "qty": 1 }] },
