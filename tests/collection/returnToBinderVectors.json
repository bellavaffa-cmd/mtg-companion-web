      "name": "the pull list: a copy pulled from a binder sorts the deck's card into it",
      "places": ["box"],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "name": "Sol Ring", "qty": 1, "places": [{ "placeId": "box", "qty": 1 }] }] },
