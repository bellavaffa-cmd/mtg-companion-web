{
  "about": "Copies moving between binders and decks (src/collection/binderFlows.ts, the Android app's data/BinderFlows.kt): into a deck out of a binder the copies leave it and the deck's card is sorted into it (binders: [{ id, qty, foil? }]), the spot noted on the deck (cameFrom); out of a deck the copies in no binder go first, to No binder, then the last ref first, back into its binder (a binder that's gone: No binder), to the spot it came from. Run by tests/collection/binderFlows.test.ts and the Android app's BinderFlowsTest.kt. 'places' are the storage places there are (ids). A collection is { id, type, entries: [{ id, name?, qty, foil?, places?: [{ placeId, qty, foil?, section? }] }] } ('unsorted' is the pile); the deck { id, ownership?, cards: [{ id, name?, qty, proxies?, binders? }], cameFrom? } (name defaults to id). 'do' is the flow: fromBinder { binder, card, qty } (the binder screen's Move / Copy to a deck), countDown { card, to }, remove { card }, deleteDeck (keeping its cards), ownership { to }, deleteBinder { binder }, swapIn { card } (a proxy swapped for a real copy), pull (the pull list, every row ticked, Move pulled into deck box), putBack (the put-back list by where cards came from, Done). expect.collections: every collection but the Wishlist, its entries (places left out when none); expect.deck: the deck after (null: gone), proxies, binders and cameFrom left out when not set; expect.binders / expect.noBinder: the views, as in binderViewVectors.json. Every case also checks that All cards' real copies are the same after (less a deleted binder's own) and that the views add up to them.",
  "cases": [
    {
      "name": "binder to a physical deck: the copies leave, the card is sorted into the binder, its spot noted",
      "places": ["box"],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "name": "Sol Ring", "qty": 2, "places": [{ "placeId": "box", "qty": 1, "section": "C" }] }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "cards": [] },
      "do": { "flow": "fromBinder", "binder": "b1", "card": "sol", "qty": 2 },
      "expect": {
        "collections": { "b1": [], "unsorted": [] },
        "deck": { "cards": [{ "id": "sol", "qty": 2, "binders": [{ "id": "b1", "qty": 2 }] }], "cameFrom": [{ "name": "Sol Ring", "placeId": "box", "qty": 1, "section": "C" }] },
        "binders": { "b1": { "own": 0, "deck": [["d1", "sol", 2]] } },
        "noBinder": { "own": 0, "deck": [] }
      }
    },
    {
      "name": "binder to a physical deck that has the card: plain first, the foil counted on the ref",
      "places": [],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "qty": 1, "foil": 1 }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "cards": [{ "id": "sol", "qty": 1, "binders": [] }] },
      "do": { "flow": "fromBinder", "binder": "b1", "card": "sol", "qty": 2 },
      "expect": {
        "collections": { "b1": [], "unsorted": [] },
        "deck": { "cards": [{ "id": "sol", "qty": 3, "binders": [{ "id": "b1", "qty": 2, "foil": 1 }] }] },
        "binders": { "b1": { "own": 0, "deck": [["d1", "sol", 2]] } },
        "noBinder": { "own": 0, "deck": [["d1", "sol", 1]] }
      }
    },
    {
      "name": "binder to a proxy deck: the copy is a real one there",
      "places": [],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "qty": 1 }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "ownership": "PROXY", "cards": [{ "id": "sol", "qty": 1 }] },
      "do": { "flow": "fromBinder", "binder": "b1", "card": "sol", "qty": 1 },
      "expect": {
        "collections": { "b1": [], "unsorted": [] },
        "deck": { "cards": [{ "id": "sol", "qty": 2, "proxies": 1, "binders": [{ "id": "b1", "qty": 1 }] }] },
        "binders": { "b1": { "own": 0, "deck": [["d1", "sol", 1]] } },
        "noBinder": { "own": 0, "deck": [] }
      }
    },
    {
      "name": "binder to a virtual deck: only the card is listed, the copy stays in the binder",
      "places": [],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "qty": 1 }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "ownership": "VIRTUAL", "cards": [] },
      "do": { "flow": "fromBinder", "binder": "b1", "card": "sol", "qty": 1 },
      "expect": {
        "collections": { "b1": [{ "id": "sol", "qty": 1 }], "unsorted": [] },
        "deck": { "cards": [{ "id": "sol", "qty": 1 }] },
        "binders": { "b1": { "own": 1, "deck": [] } },
        "noBinder": { "own": 0, "deck": [] }
      }
    },
    {
      "name": "No binder to a physical deck: no binder ref, the spot noted",
      "places": ["box"],
      "collections": [
        { "id": "unsorted", "type": "OWNED", "entries": [{ "id": "sol", "name": "Sol Ring", "qty": 1, "places": [{ "placeId": "box", "qty": 1 }] }] }
      ],
      "deck": { "id": "d1", "cards": [] },
      "do": { "flow": "fromBinder", "binder": "unsorted", "card": "sol", "qty": 1 },
      "expect": {
        "collections": { "unsorted": [] },
        "deck": { "cards": [{ "id": "sol", "qty": 1 }], "cameFrom": [{ "name": "Sol Ring", "placeId": "box", "qty": 1 }] },
