      ],
      "deck": { "id": "d1", "cards": [{ "id": "sol", "qty": 2, "binders": [{ "id": "b1", "qty": 2 }] }] },
      "do": { "flow": "ownership", "to": "PROXY" },
      "expect": {
        "collections": { "b1": [{ "id": "sol", "qty": 2 }], "unsorted": [] },
        "deck": { "ownership": "PROXY", "cards": [{ "id": "sol", "qty": 2, "binders": [] }] },
        "binders": { "b1": { "own": 2, "deck": [] } },
        "noBinder": { "own": 0, "deck": [] }
      }
    },
    {
      "name": "delete a binder: its own copies go; deck copies stay in their deck, in No binder",
      "places": [],
      "collections": [
        { "id": "b1", "type": "OWNED", "entries": [{ "id": "sol", "qty": 1 }] },
        { "id": "unsorted", "type": "OWNED", "entries": [] }
      ],
      "deck": { "id": "d1", "cards": [{ "id": "sol", "qty": 1, "binders": [{ "id": "b1", "qty": 1 }] }] },
      "do": { "flow": "deleteBinder", "binder": "b1" },
      "expect": {
        "collections": { "unsorted": [] },
